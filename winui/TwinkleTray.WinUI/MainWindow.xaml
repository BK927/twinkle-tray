<Window x:Class="TwinkleTray.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Twinkle Tray">
    <Grid x:Name="Root" KeyDown="Root_KeyDown">
      <Border x:Name="SolidBackground" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
      <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" IsHitTestVisible="False" />
      <Grid x:Name="PanelLayout" Padding="16,12" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PanelHeader" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Adjust Brightness" TextTrimming="CharacterEllipsis" />
            <ToggleButton x:Name="LinkButton" Grid.Column="1" Style="{StaticResource ToolbarToggleButtonStyle}" Click="Link_Click"><FontIcon Glyph="&#xE71B;" FontSize="16"/></ToggleButton>
            <Button x:Name="PowerButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="Power_Click"><FontIcon Glyph="&#xE7E8;" FontSize="16"/></Button>
            <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Click="Settings_Click"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" IsTabStop="False">
            <StackPanel x:Name="PanelBody" Spacing="12" Padding="0,4,0,4">
                <StackPanel x:Name="MonitorList" Spacing="16" />
                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" FontSize="13" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="PanelFooter" Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Text="Twinkle Tray · WinUI 3" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
        </Grid>
      </Grid>
    </Grid>
</Window>
