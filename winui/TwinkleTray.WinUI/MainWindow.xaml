<Window x:Class="TwinkleTray.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Twinkle Tray">
    <Grid x:Name="Root" Padding="18,14,18,12" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" VerticalAlignment="Center" FontSize="14" Text="Adjust Brightness" />
            <ToggleButton x:Name="LinkButton" Grid.Column="1" Padding="7" Click="Link_Click"><FontIcon Glyph="&#xE71B;" FontSize="18"/></ToggleButton>
            <Button x:Name="PowerButton" Grid.Column="2" Padding="7" Click="Power_Click"><FontIcon Glyph="&#xE7E8;" FontSize="18"/></Button>
            <Button x:Name="SettingsButton" Grid.Column="3" Padding="7" Click="Settings_Click"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MonitorList" Spacing="12" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="7">
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Text="Twinkle Tray · WinUI 3" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Grid.Column="1" Padding="5" Click="Refresh_Click"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
