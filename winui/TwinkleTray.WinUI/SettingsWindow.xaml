<Window
    x:Class="TwinkleTray.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Twinkle Tray Settings">
    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE706;" FontSize="16" />
                <TextBlock x:Name="WindowTitle" Text="Twinkle Tray" FontSize="12" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" PaneDisplayMode="Left"
                        OpenPaneLength="244" IsPaneOpen="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralNavigation" Tag="general" Content="General" Icon="Setting" />
                <NavigationViewItem x:Name="MonitorsNavigation" Tag="monitors" Content="Monitor Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FeaturesNavigation" Tag="features" Content="DDC/CI Features">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TimeNavigation" Tag="time" Content="Time Adjustments" Icon="Clock" />
                <NavigationViewItem x:Name="HotkeysNavigation" Tag="hotkeys" Content="Hotkeys &amp; Shortcuts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="IdleNavigation" Tag="idle" Content="Idle Detection">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE708;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigation" Tag="profiles" Content="Profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SensorsNavigation" Tag="sensors" Content="Light Sensor">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE706;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AdvancedNavigation" Tag="advanced" Content="Advanced">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UpdatesNavigation" Tag="updates" Content="Updates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigation" Tag="about" Content="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PageContent" Margin="28,16,28,32" Spacing="10" MaxWidth="940"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </NavigationView>
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational" Margin="16,0,16,12" />
        <InfoBar x:Name="SettingsError" Grid.Row="1" IsOpen="False" IsClosable="True"
                 Severity="Error" VerticalAlignment="Bottom" Margin="260,0,16,16" />
    </Grid>
</Window>
