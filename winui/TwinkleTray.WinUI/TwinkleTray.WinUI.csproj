<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TwinkleTray.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../src/assets/logo.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.2.0</Version>
    <Description>Community WinUI 3 port of Twinkle Tray</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <ProjectReference Include="../TwinkleTray.Core/TwinkleTray.Core.csproj" />
    <ProjectReference Include="../TwinkleTray.Hardware/TwinkleTray.Hardware.csproj" />
    <Content Include="../../src/localization/*.json" Link="Localization/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/logo.ico" Link="Assets/logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/logo-512.png" Link="Assets/logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/tray-icons/dark/fluent.ico" Link="Assets/tray-dark.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/tray-icons/light/fluent.ico" Link="Assets/tray-light.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/assets/tray-icons/**/*.ico" Link="Assets/tray-icons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
